========================= */

function startDownload(
    name,
    link
){

    if(
        !link ||
        link.includes("YOUR-LINK-HERE")
    ){

        showToast(
            "⚠️ Tool này chưa được gắn link tải."
        );

        return;

    }

    currentDownloadLink = link;

    document
        .getElementById("downloadTitle")
        .innerText =
            "Preparing " + name;

    document
        .getElementById("downloadModal")
        .classList
        .add("active");

    document
        .getElementById("realDownload")
        .style.display = "none";

    let seconds = 5;

    document
        .getElementById("countdown")
        .innerText = seconds;

    clearInterval(countdownTimer);

    countdownTimer =
        setInterval(function(){

            seconds--;

            document
                .getElementById("countdown")
                .innerText = seconds;

            if(seconds <= 0){

                clearInterval(countdownTimer);

                document
                    .getElementById("countdown")
                    .innerText =
                        "✓";

                document
                    .getElementById("realDownload")
                    .style.display = "block";

            }

        },1000);

}


