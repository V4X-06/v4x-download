========================= */

window.addEventListener(
    "click",
    function(event){

        const infoModal =
            document.getElementById("infoModal");

        const downloadModal =
            document.getElementById("downloadModal");

        if(event.target === infoModal){

            closeInfo();

        }

        if(event.target === downloadModal){

            closeDownload();

        }

    }
);


/* =========================
   ESC CLOSE
========================= */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            closeInfo();

            closeDownload();

        }

    }
);


/* =========================
