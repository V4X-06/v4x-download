    if(!currentDownloadLink){

        showToast(
            "Link tải không hợp lệ."
        );

        return;

    }

    window.open(
        currentDownloadLink,
        "_blank",
        "noopener,noreferrer"
    );

    showToast(
        "📥 Đang mở link tải..."
    );

}


function closeDownload(){

    clearInterval(countdownTimer);

    document
        .getElementById("downloadModal")
        .classList
        .remove("active");

}


