const canvas = document.getElementById("fireworks");
const ctx = canvas.getContext("2d");

const fireBtn = document.getElementById("fireBtn");
const autoBtn = document.getElementById("autoBtn");
const clearBtn = document.getElementById("clearBtn");
const countText = document.getElementById("count");

let width;
let height;

let rockets = [];
let particles = [];

let autoMode = false;
let autoTimer = null;

let totalFireworks = 0;

function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
}

window.addEventListener("resize", resize);
resize();

function random(min, max) {
    return Math.random() * (max - min) + min;
}

function randomColor() {
    const colors = [
        "#ff004c",
        "#ff00cc",
        "#7b00ff",
        "#00d9ff",
        "#00ff88",
        "#ffe600",
        "#ffffff",
        "#ff7b00"
    ];

    return colors[
        Math.floor(Math.random() * colors.length)
    ];
}

class Rocket {

    constructor(x, targetY) {

        this.x = x;

        this.y = height + 10;

        this.targetY = targetY;

        this.speed = random(7, 11);

        this.color = randomColor();

        this.dead = false;
    }

    update() {

        this.y -= this.speed;

        this.speed *= 0.985;

        if (this.y <= this.targetY) {

            explode(
                this.x,
                this.y,
                this.color
            );

            this.dead = true;
        }
    }

    draw() {

        ctx.beginPath();

        ctx.arc(
            this.x,
            this.y,
            2,
            0,
            Math.PI * 2
        );

        ctx.fillStyle = this.color;

        ctx.shadowBlur = 15;
        ctx.shadowColor = this.color;

        ctx.fill();

        ctx.shadowBlur = 0;
    }
}

class Particle {

    constructor(x, y, color, angle, speed) {

        this.x = x;
        this.y = y;

        this.color = color;

        this.angle = angle;

        this.speed = speed;

        this.life = random(55, 110);

        this.maxLife = this.life;

        this.gravity = 0.045;

        this.friction = 0.985;

        this.size = random(1, 3);
    }

    update() {

        this.speed *= this.friction;

        this.x += Math.cos(this.angle) * this.speed;

        this.y += Math.sin(this.angle) * this.speed;

        this.y += this.gravity;

        this.life--;
    }

    draw() {

        const alpha =
            this.life / this.maxLife;

        ctx.beginPath();

        ctx.arc(
            this.x,
            this.y,
            this.size,
            0,
            Math.PI * 2
        );

        ctx.fillStyle =
            this.color;

        ctx.globalAlpha = alpha;

        ctx.shadowBlur = 15;
        ctx.shadowColor = this.color;

        ctx.fill();

        ctx.globalAlpha = 1;

        ctx.shadowBlur = 0;
    }
}

function explode(x, y, color) {

    totalFireworks++;

    countText.textContent =
        totalFireworks;

    const amount =
        Math.floor(random(70, 140));

    for (let i = 0; i < amount; i++) {

        const angle =
            Math.PI * 2 * i / amount;

        const speed =
            random(2, 8);

        particles.push(
            new Particle(
                x,
                y,
                color,
                angle,
                speed
            )
        );
    }

    // Các hạt phụ tạo hiệu ứng lấp lánh
    for (let i = 0; i < 25; i++) {

        particles.push(
            new Particle(
                x,
                y,
                "#ffffff",
                random(0, Math.PI * 2),
                random(1, 4)
            )
        );
    }
}

function launch(x, targetY) {

    rockets.push(
        new Rocket(
            x,
            targetY
        )
    );
}

function randomLaunch() {

    launch(
        random(
            width * 0.1,
            width * 0.9
        ),
        random(
            height * 0.12,
            height * 0.55
        )
    );
}

function animate() {

    requestAnimationFrame(animate);

    ctx.fillStyle =
        "rgba(2, 0, 8, 0.20)";

    ctx.fillRect(
        0,
        0,
        width,
        height
    );

    for (
        let i = rockets.length - 1;
        i >= 0;
        i--
    ) {

        rockets[i].update();

        rockets[i].draw();

        if (rockets[i].dead) {

            rockets.splice(i, 1);
        }
    }

    for (
        let i = particles.length - 1;
        i >= 0;
        i--
    ) {

        particles[i].update();

        particles[i].draw();

        if (particles[i].life <= 0) {

            particles.splice(i, 1);
        }
    }
}

animate();

fireBtn.addEventListener(
    "click",
    () => {

        randomLaunch();

        // Bắn thêm 2 quả ngẫu nhiên
        setTimeout(
            randomLaunch,
            180
        );

        setTimeout(
            randomLaunch,
            360
        );
    }
);

autoBtn.addEventListener(
    "click",
    () => {

        autoMode = !autoMode;

        if (autoMode) {

            autoBtn.textContent =
                "⏹ TẮT TỰ ĐỘNG";

            autoBtn.classList.add(
                "active"
            );

            randomLaunch();

            autoTimer =
                setInterval(
                    () => {

                        const amount =
                            Math.random() > .65
                                ? 2
                                : 1;

                        for (
                            let i = 0;
                            i < amount;
                            i++
                        ) {

                            setTimeout(
                                randomLaunch,
                                i * 250
                            );
                        }

                    },
                    900
                );

        } else {

            autoBtn.textContent =
                "▶ BẬT TỰ ĐỘNG";

            autoBtn.classList.remove(
                "active"
            );

            clearInterval(
                autoTimer
            );
        }
    }
);

clearBtn.addEventListener(
    "click",
    () => {

        rockets = [];
        particles = [];

        ctx.clearRect(
            0,
            0,
            width,
            height
        );
    }
);

// Bấm/chạm màn hình để bắn
canvas.addEventListener(
    "pointerdown",
    (event) => {

        launch(
            event.clientX,
            event.clientY
        );
    }
);
