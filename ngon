# 7. `style.css`

```css
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;

    color: #fff;

    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(0,180,255,.12),
            transparent 30%
        ),
        radial-gradient(
            circle at 85% 70%,
            rgba(120,70,255,.10),
            transparent 30%
        ),
        #06080c;

    font-family:
        Arial,
        Helvetica,
        sans-serif;
}


body::before {
    content: "";

    position: fixed;

    inset: 0;

    z-index: -1;

    opacity: .35;

    background-image:
        linear-gradient(
            rgba(255,255,255,.025) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.025) 1px,
            transparent 1px
        );

    background-size: 50px 50px;
}


/* HEADER */

.header {

    position: sticky;

    top: 0;

    z-index: 100;

    min-height: 76px;

    padding:
        0 7%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    background:
        rgba(5,7,11,.88);

    backdrop-filter:
        blur(15px);

    border-bottom:
        1px solid rgba(255,255,255,.08);
}


.logo {

    display: flex;

    align-items: center;

    gap: 12px;

    color: #fff;

    text-decoration: none;
}


.logo-box {

    width: 48px;

    height: 48px;

    display: grid;

    place-items: center;

    border-radius: 12px;

    border:
        1px solid rgba(80,210,255,.6);

    background:
        linear-gradient(
            135deg,
            #0b1820,
            #141126
        );

    box-shadow:
        0 0 25px
        rgba(0,180,255,.15);

    font-weight: 1000;
}


.logo b {

    display: block;

    font-size: 14px;

    letter-spacing: 2px;
}


.logo small {

    display: block;

    margin-top: 3px;

    color: #687483;

    font-size: 9px;

    letter-spacing: 3px;
}


nav {

    display: flex;

    gap: 25px;
}


nav a {

    color: #8994a3;

    text-decoration: none;

    font-size: 12px;

    font-weight: 800;

    transition: .25s;
}


nav a:hover,
nav a.active {

    color: #6bdcff;
}


/* HERO */

.hero {

    min-height: 560px;

    padding:
        100px 8%;

    display: flex;

    align-items: center;

    position: relative;

    overflow: hidden;
}


.hero-text {

    max-width: 750px;

    position: relative;

    z-index: 2;
}


.tag {

    display: inline-block;

    padding: 8px 14px;

    margin-bottom: 20px;

    border:
        1px solid rgba(80,210,255,.35);

    border-radius: 30px;

    color: #6bdcff;

    background:
        rgba(0,180,255,.06);

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 2px;
}


.hero h1 {

    font-size:
        clamp(48px, 8vw, 90px);

    line-height: .92;

    letter-spacing: -5px;
}


.hero h1 span {

    display: block;

    background:
        linear-gradient(
            90deg,
            #fff,
            #66dcff,
            #9c7cff
        );

    color: transparent;

    -webkit-background-clip: text;

    background-clip: text;
}


.hero p {

    max-width: 600px;

    margin-top: 25px;

    color: #7e8998;

    line-height: 1.7;

    font-size: 15px;
}


.buttons {

    display: flex;

    gap: 10px;

    margin-top: 30px;
}


.btn {

    padding:
        14px 23px;

    border-radius: 9px;

    border:
        1px solid rgba(255,255,255,.12);

    color: #fff;

    background:
        rgba(255,255,255,.04);

    text-decoration: none;

    font-size: 11px;

    font-weight: 900;

    transition: .25s;
}


.btn:hover {

    transform:
        translateY(-3px);

    border-color:
        rgba(80,210,255,.4);
}


.btn.primary {

    color: #061018;

    border: none;

    background:
        linear-gradient(
            135deg,
            #66dcff,
            #9b80ff
        );
}


.dragon {

    position: absolute;

    right: 7%;

    font-size: 260px;

    opacity: .08;

    animation:
        floatDragon 5s ease-in-out infinite;
}


@keyframes floatDragon {

    0%,100% {
        transform:
            translateY(0)
            rotate(-3deg);
    }

    50% {
        transform:
            translateY(-20px)
            rotate(3deg);
    }
}


/* STATS */

.stats {

    width: 84%;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    border:
        1px solid rgba(255,255,255,.08);

    border-radius: 15px;

    overflow: hidden;

    background:
        rgba(255,255,255,.025);
}


.stats div {

    padding: 25px;

    text-align: center;

    border-right:
        1px solid rgba(255,255,255,.07);
}


.stats div:last-child {
    border-right: none;
}


.stats strong {

    display: block;

    font-size: 25px;

    background:
        linear-gradient(
            90deg,
            #fff,
            #68dcff
        );

    color: transparent;

    -webkit-background-clip: text;
}


.stats span {

    display: block;

    margin-top: 5px;

    color: #626e7d;

    font-size: 9px;

    letter-spacing: 2px;
}


/* SECTIONS */

.section {

    width: 84%;

    margin:
        110px auto;
}


.title {

    margin-bottom: 30px;
}


.title small,
.page-head small {

    color: #68d9ff;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 3px;
}


.title h2 {

    margin-top: 8px;

    font-size: 38px;
}


.title span,
.page-head span {

    color: #68d9ff;
}


/* CATEGORIES */

.category-grid {

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    gap: 15px;
}


.category {

    padding: 28px;

    color: #fff;

    text-decoration: none;

    text-align: center;

    border:
        1px solid rgba(255,255,255,.08);

    border-radius: 15px;

    background:
        rgba(255,255,255,.025);

    transition: .25s;
}


.category:hover {

    transform:
        translateY(-6px);

    border-color:
        rgba(80,210,255,.35);
}


.category div {

    margin-bottom: 15px;

    font-size: 30px;
}


.category h3 {

    font-size: 13px;

    margin-bottom: 8px;
}


.category p {

    color: #707b8a;

    font-size: 11px;

    line-height: 1.6;
}


/* PAGE */

.page-head {

    width: 84%;

    margin:
        90px auto 35px;
}


.page-head h1 {

    margin-top: 12px;

    font-size:
        clamp(40px,6vw,70px);

    letter-spacing: -3px;
}


.page-head p {

    margin-top: 12px;

    color: #788493;

    font-size: 14px;
}


/* SEARCH */

.search {

    max-width: 450px;

    margin-top: 25px;
}


.search input {

    width: 100%;

    padding: 15px 17px;

    outline: none;

    color: #fff;

    border:
        1px solid rgba(255,255,255,.12);

    border-radius: 10px;

    background:
        rgba(255,255,255,.04);
}


.search input:focus {

    border-color:
        rgba(80,210,255,.5);
}


/* FILE GRID */

.file-grid {

    width: 84%;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 15px;
}


.file-card {

    padding: 23px;

    border:
        1px solid rgba(255,255,255,.08);

    border-radius: 15px;

    background:
        rgba(255,255,255,.03);

    transition: .25s;
}


.file-card:hover {

    transform:
        translateY(-5px);

    border-color:
        rgba(80,210,255,.4);
}


.file-icon {

    width: 45px;

    height: 45px;

    display: grid;

    place-items: center;

    margin-bottom: 17px;

    border-radius: 10px;

    background:
        rgba(0,180,255,.08);

    border:
        1px solid rgba(0,200,255,.2);
}


.file-card h3 {

    font-size: 14px;

    margin-bottom: 9px;
}


.file-card p {

    min-height: 38px;

    color: #778291;

    font-size: 11px;

    line-height: 1.5;
}


.file-info {

    display: flex;

    justify-content: space-between;

    margin-top: 17px;

    color: #5f6a79;

    font-size: 9px;
}


.download {

    width: 100%;

    margin-top: 16px;

    padding: 12px;

    border: none;

    border-radius: 8px;

    color: #fff;

    background:
        linear-gradient(
            90deg,
            rgba(0,160,255,.25),
            rgba(120,70,255,.25)
        );

    cursor: pointer;

    font-size: 10px;

    font-weight: 900;
}


.download:hover {

    background:
        linear-gradient(
            90deg,
            rgba(0,160,255,.45),
            rgba(120,70,255,.45)
        );
}


/* FOOTER */

footer {

    margin-top: 120px;

    padding: 45px;

    text-align: center;

    border-top:
        1px solid rgba(255,255,255,.08);

    color: #626d7b;
}


footer b {

    color: #fff;

    font-size: 24px;
}


footer p {

    margin-top: 10px;

    font-size: 10px;
}


/* MOBILE */

@media(max-width:900px) {

    nav {
        display: none;
    }

    .stats,
    .category-grid,
    .file-grid {
        grid-template-columns:
            repeat(2,1fr);
    }

    .hero {
        padding:
            70px 20px;
    }

    .page-head,
    .file-grid,
    .section {
        width: calc(100% - 40px);
    }
}


@media(max-width:600px) {

    .stats,
    .category-grid,
    .file-grid {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 48px;
    }

    .dragon {
        right: -40px;
        font-size: 160px;
    }

    .stats div {
        border-right: none;
    }
}
```

